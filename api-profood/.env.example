APP_NAME=Profood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# For local development, use individual DB_* variables
# For production (Heroku), set DATABASE_URL which will override individual variables
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=profood
DB_USERNAME=postgres
DB_PASSWORD=

# Optional: Heroku-style DATABASE_URL (overrides individual DB_* variables)
# Format: postgres://username:password@host:port/database
# DATABASE_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Queue Configuration
# Use 'database' for asynchronous email sending (recommended for production)
# Use 'sync' for synchronous processing (blocks HTTP requests)
# NOTE: 'database' requires a running worker (Procfile 'worker:' /
# `php artisan queue:work`). On LWS shared hosting there is NO worker process,
# so queued emails (order confirmations, status updates) never send there —
# set QUEUE_CONNECTION=sync on LWS so jobs run inline during the request.
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@profood-app.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP Configuration (optional, only if using smtp mailer)
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Third-Party Service Credentials
# ===================================

# Twilio SMS Service
# Used for phone number verification during user registration
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Postmark Email Service
# Used for transactional emails (order confirmations, notifications)
# Get token from: https://account.postmarkapp.com
POSTMARK_TOKEN=

# PayTech Payment Gateway
# Senegalese mobile money payment processor
# Get credentials from: https://paytech.sn
PAY_TECH_API_KEY=
PAY_TECH_API_SECRET=

# PayTech runs in SANDBOX unless this is explicitly set to false.
# Production must set PAYTECH_TEST_MODE=false to charge real payments.
PAYTECH_TEST_MODE=true

# Public URL of the customer app (PayTech success/cancel redirects)
CLIENT_APP_URL=https://profood-app.com

# WARNING: Only set to true for local development if SSL certificate issues occur
# Never disable SSL verification in production - this is a security risk!
# PAYTECH_DISABLE_SSL_VERIFY=false

# API Token Configuration
# Duration in minutes before API tokens expire
# Default: 43200 minutes (30 days)
# Set to 0 to disable expiration (not recommended for production)
API_TOKEN_EXPIRATION_MINUTES=43200

# Per-app keys gating which roles may sign in from each frontend.
# These are matched in UserController@signin against the `app_key` body field.
# PROFOOD_APP_KEY            -> Customer mobile app   (Role::CUSTOMER)
# PROFOOD_APP_MANAGER_KEY    -> Manager web panel     (Role::ADMIN, MANAGER, SUPER_ADMIN)
# PROFOOD_APP_LIVREUR_KEY    -> Driver mobile app     (Role::LIVREUR)
PROFOOD_APP_KEY=
PROFOOD_APP_MANAGER_KEY=
PROFOOD_APP_LIVREUR_KEY=

# AWS Configuration (optional - only if using S3 for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# Redis Configuration (optional - only if using Redis)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
