# Content Security Policy Configuration
# Add these variables to your .env file to customize CSP behavior

# Enable or disable CSP globally (default: true)
CSP_ENABLED=true

# Report-only mode: violations are reported but not enforced (default: false)
# Useful for testing CSP policies before enforcing them
# Uses Content-Security-Policy-Report-Only header
CSP_REPORT_ONLY=false

# URI where CSP violation reports should be sent (default: null)
# Example: /api/csp-violation-report
# Set this to monitor CSP violations in production
CSP_REPORT_URI=

# Enable HSTS (HTTP Strict Transport Security) header (default: true)
# Only applies in production if production_only is set in config/csp.php
HSTS_ENABLED=true
