# ─────────────────────────────────────────────────────────────────────────
# Clé applicative — OBLIGATOIRE pour l'authentification.
# Envoyée à l'API comme `app_key` sur /signin, /signup, /password-reset, etc.
# Doit être IDENTIQUE au PROFOOD_APP_KEY défini côté serveur (api-profood/.env).
# Si absente au moment du BUILD, l'API de production (PROFOOD_APP_KEY non vide)
# rejette toute connexion/inscription du rôle CUSTOMER.
# (Équivalent de REACT_APP_KEY dans l'app Ionic.)
VITE_APP_KEY=

# Catalogue depuis l'API (get-slices / get-categories) au lieu du JSON local.
# Recommandé en prod. Les images restent les assets locaux (résolus par id).
VITE_USE_API_CATALOG=

# Commandes RÉELLES via l'API : localités + frais serveur (quote-delivery-fee),
# checkout invité → POST /guest-order(-with-payment), connecté → panier serveur
# + /add-order-*(with|without)-payment, paiement en ligne PayTech (redirection),
# statut réel dans l'historique/le suivi. Sans ce drapeau : commandes locales
# de démo (localStorage), comme avant. Mettre `true` en prod.
VITE_USE_API_ORDERS=

# La base URL de l'API est détectée automatiquement (cf. src/api/client.ts) :
#   build (prod)  → https://api.profood-app.com/api/
#   dev (npm dev) → http://localhost:8000/api/
