# Profood Livreur App — environment variables
# Copy this file to .env.local for local development.

# App key sent in the POST /signin request body.
# Must match the PROFOOD_APP_LIVREUR_KEY env var defined in api-profood/.env.
# Drivers (users with role code 4 = Role::LIVREUR) authenticate against the
# /signin endpoint with this key.
VITE_PROFOOD_APP_LIVREUR_KEY=your_profood_app_livreur_key_here

# Optional: override the API base URL for local development.
# Defaults to http://localhost:8000/api/ in dev and https://api.profood-app.com/api/ in prod.
# VITE_API_BASE_URL=http://localhost:8000/api/
