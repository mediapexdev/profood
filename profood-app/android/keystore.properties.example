# Rename to keystore.properties and fill in. Never commit the real file.
# Generate the keystore with:
#   keytool -genkey -v -keystore profood-customer-release.jks \
#       -keyalg RSA -keysize 2048 -validity 10000 \
#       -alias profood-customer
#
# storeFile is resolved relative to the `android/` directory.
storeFile=profood-customer-release.jks
storePassword=CHANGE_ME
keyAlias=profood-customer
keyPassword=CHANGE_ME
