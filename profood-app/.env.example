# Copy to .env and fill in real values. All keys must be prefixed REACT_APP_
# (Create React App only exposes REACT_APP_* to the browser bundle).

# Firebase Configuration (client-safe public keys)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# REQUIRED for authentication. The app sends this as `app_key` on signup,
# signin, password-reset and convert-guest-order. It MUST equal the API's
# PROFOOD_APP_KEY (api-profood .env). If it is missing at BUILD time, a
# production API with a non-empty PROFOOD_APP_KEY rejects every signup and
# signin with 401 "Demande rejetée ! Accès non autorisé".
# Local dev works with this left blank only because the local API leaves
# PROFOOD_APP_KEY unset too (empty == empty). Inject the real value in the
# production build pipeline; do NOT commit the secret.
REACT_APP_KEY=
